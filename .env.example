# Telegram
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated list of admin Telegram user IDs
ADMIN_IDS=123456789,987654321

# PostgreSQL credentials (used by the db service)
POSTGRES_USER=movie_bot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=movie_bot

# Async SQLAlchemy connection string. Host "db" matches the compose service name.
DATABASE_URL=postgresql+asyncpg://movie_bot:changeme@db:5432/movie_bot

# Azure OpenAI image generation/editing (gpt-image-2 deployment).
# The Images Edit endpoint requires api-version 2025-04-01-preview.
AZURE_OPENAI_ENDPOINT_IMAGE=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY_IMAGE=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_IMAGE=gpt-image-2
AZURE_OPENAI_API_VERSION=2025-04-01-preview
